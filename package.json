{
  "name": "next-static-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:real": "RUN_REAL_NEXTJS=1 playwright test",
    "ci:rsc": "node scripts/quanta-ci.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:macos:arm": "tauri build --target aarch64-apple-darwin",
    "tauri:macos:intel": "tauri build --target x86_64-apple-darwin",
    "tauri:macos:universal": "tauri build --target universal-apple-darwin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
